# Copy to .env and fill in. docker compose reads .env automatically.

# API token for the model. Optional: without it, enter a key in the console's Settings dialog.
ANTHROPIC_API_KEY=

# Model that writes replies, and the one that reads each caller message into a structured record.
SOP_MODEL=claude-opus-5-5
SOP_NLU_MODEL=claude-haiku-5-5

# Thinking effort for both calls: low | medium | high. Low keeps a chat turn quick.
SOP_EFFORT=low

# anthropic | stub. "stub" runs the harness on keyword rules with no model and no key.
LLM_PROVIDER=anthropic

# The sample data describes early March 2026. Use "real" for the wall clock.
DEMO_TODAY=2026-03-02
